#!/bin/bash
# Sketchatone Setup Script
# Configures auto-start mode and generates udev rules from device configs

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
print_error() { echo -e "${RED}[ERROR]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }

# Default paths
INSTALL_DIR="/opt/sketchatone"
CONFIG_DIR="$INSTALL_DIR/configs"
DEVICES_DIR="$INSTALL_DIR/python/sketchatone/tablet/otd/configs"
UDEV_RULES_FILE="/etc/udev/rules.d/99-sketchatone.rules"
SERVICE_FILE="/etc/systemd/system/sketchatone.service"
UI_AUTOSTART_MARKER="/etc/sketchatone/ui-autostart-user"

# Show usage
show_usage() {
    cat << USAGE
Sketchatone Setup Script

Usage: $0 [OPTIONS]

Options:
    --mode <mode>       Set auto-start mode:
                          usb-trigger  - Start when tablet is plugged in (recommended)
                          always-on    - Start on system boot
                          manual       - No auto-start, run manually
    
    --list-devices      List detected device configs and their vendor/product IDs
    --status            Show current configuration status
    --help              Show this help message

UI autostart requires always-on mode. Before selecting usb-trigger or
manual, disable it with:
    sudo sketchatone-ui-setup-autostart --uninstall --user <name>

Examples:
    $0 --mode usb-trigger    # Auto-start when tablet is plugged in
    $0 --mode always-on      # Traditional always-running service
    $0 --mode manual         # Disable auto-start
    $0 --list-devices        # Show available device configs
    $0 --status              # Show current setup

USAGE
}

# Check if running as root
check_root() {
    if [ "$EUID" -ne 0 ]; then
        print_error "This script must be run as root (use sudo)"
        exit 1
    fi
}

# Check if sketchatone is installed
check_installed() {
    if [ ! -d "$INSTALL_DIR" ]; then
        print_error "Sketchatone not found at $INSTALL_DIR"
        print_error "Please install sketchatone first"
        exit 1
    fi
}

check_ui_autostart_mode() {
    if [ "$1" != "always-on" ] && [ -e "$UI_AUTOSTART_MARKER" ]; then
        local ui_user
        ui_user="$(cat "$UI_AUTOSTART_MARKER")"
        print_error "UI autostart is enabled for ${ui_user:-an unknown user}; it requires always-on mode."
        print_info "Disable UI autostart first:"
        printf '  sudo sketchatone-ui-setup-autostart --uninstall --user %q\n' "${ui_user:-<name>}"
        print_info "Or remove all managed UI autostart blocks with:"
        echo "  sudo sketchatone-ui-setup-autostart --uninstall-all"
        exit 1
    fi
}

# Extract vendor/product IDs from device config JSON files
# Returns lines in format: vendor_id:product_id:device_name
get_device_ids() {
    PYTHONPATH="$INSTALL_DIR/python${PYTHONPATH:+:$PYTHONPATH}" python3 - "$1" "$CONFIG_DIR/devices" << 'PYEOF'
import json
import sys
from pathlib import Path

from sketchatone.tablet.otd.config_loader import load_config_file

root = Path(sys.argv[1])
if not root.is_dir():
    sys.exit(f"Tablet config directory not found: {root}")

pairs = {}
for path in sorted(root.rglob("*.json")):
    config = load_config_file(path)
    for identifier in config.digitizer_identifiers:
        pairs.setdefault((identifier.vendor_id, identifier.product_id), config.name)

# Preserve support for locally installed legacy device definitions.
for path in sorted(Path(sys.argv[2]).glob("*.json")):
    data = json.loads(path.read_text(encoding="utf-8"))
    vendor = data["vendorId"]
    product = data["productId"]
    pair = (
        int(vendor, 16) if isinstance(vendor, str) else vendor,
        int(product, 16) if isinstance(product, str) else product,
    )
    pairs.setdefault(pair, data.get("name", path.stem))

if not pairs:
    sys.exit(f"No tablet device identifiers found in {root}")
for (vendor, product), name in sorted(pairs.items()):
    name = " ".join(name.splitlines()).replace(":", " ")
    print(f"{vendor:04x}:{product:04x}:{name}")
PYEOF
}

# List available device configs
list_devices() {
    print_info "Scanning device configs in $DEVICES_DIR..."
    echo ""
    
    local device_ids
    device_ids="$(get_device_ids "$DEVICES_DIR")" || return $?
    local found=0
    while IFS=: read -r vendor product name; do
        if [ -n "$vendor" ]; then
            echo "  📱 $name"
            echo "     Vendor ID:  0x$vendor"
            echo "     Product ID: 0x$product"
            echo ""
            found=$((found + 1))
        fi
    done <<< "$device_ids"
    
    if [ $found -eq 0 ]; then
        print_warning "No device configs found in $DEVICES_DIR"
        echo "Add device JSON files with vendorId and productId fields"
    else
        print_info "Found $found device config(s)"
    fi
}

# Generate udev rules from device configs
generate_udev_rules() {
    print_info "Generating udev rules from device configs..."
    local device_ids
    device_ids="$(get_device_ids "$DEVICES_DIR")" || return $?
    
    local rules=""
    local count=0
    
    # Add header
    rules+="# Sketchatone udev rules - Auto-generated by sketchatone-setup\n"
    rules+="# Do not edit manually - run 'sketchatone-setup --mode usb-trigger' to regenerate\n"
    rules+="\n"
    
    # Add HID permission rules and systemd trigger rules for each device
    # Strip 0x prefix for PRODUCT env var matching
    while IFS=: read -r vendor product name; do
        if [ -n "$vendor" ]; then
            # Strip 0x prefix for PRODUCT matching
            # PRODUCT uses unpadded hex, unlike the four-digit sysfs attributes.
            printf -v vendor_stripped '%x' "$((16#$vendor))"
            printf -v product_stripped '%x' "$((16#$product))"

            # HID permission rule (allow non-root access)
            rules+="# $name\n"
            rules+="SUBSYSTEM==\"hidraw\", ATTRS{idVendor}==\"$vendor\", ATTRS{idProduct}==\"$product\", MODE=\"0666\"\n"

            # USB add rule - trigger systemd service
            rules+="ACTION==\"add\", SUBSYSTEM==\"usb\", ATTR{idVendor}==\"$vendor\", ATTR{idProduct}==\"$product\", TAG+=\"systemd\", ENV{SYSTEMD_WANTS}=\"sketchatone.service\"\n"

            # USB remove rule - stop service
            # On remove, ATTR is not available, so we match on PRODUCT env var (format: vendor/product/bcdDevice)
            rules+="ACTION==\"remove\", SUBSYSTEM==\"usb\", ENV{PRODUCT}==\"$vendor_stripped/$product_stripped/*\", RUN+=\"/bin/systemctl stop sketchatone.service\"\n"
            rules+="\n"

            count=$((count + 1))
        fi
    done <<< "$device_ids"
    
    if [ $count -eq 0 ]; then
        print_error "No device configs found - cannot generate udev rules"
        print_error "Add device JSON files to $DEVICES_DIR"
        exit 1
    fi
    
    # Write rules file
    echo -e "$rules" > "$UDEV_RULES_FILE"
    print_success "Generated udev rules for $count device(s)"
    print_info "Rules written to: $UDEV_RULES_FILE"
}

# Remove udev rules
remove_udev_rules() {
    if [ -f "$UDEV_RULES_FILE" ]; then
        rm -f "$UDEV_RULES_FILE"
        print_info "Removed udev rules"
    fi
}

# Reload udev rules
reload_udev() {
    print_info "Reloading udev rules..."
    udevadm control --reload-rules
    udevadm trigger
    print_success "udev rules reloaded"
}

# Configure USB-triggered mode
setup_usb_trigger() {
    print_info "Configuring USB-triggered mode..."
    echo ""
    
    # Stop and disable always-on service
    if systemctl is-active --quiet sketchatone 2>/dev/null; then
        systemctl stop sketchatone
    fi
    if systemctl is-enabled --quiet sketchatone 2>/dev/null; then
        systemctl disable sketchatone
    fi
    
    # Generate udev rules
    generate_udev_rules
    reload_udev
    
    echo ""
    print_success "USB-triggered mode configured!"
    echo ""
    echo "  • Sketchatone will start automatically when a supported tablet is plugged in"
    echo "  • Sketchatone will stop when the tablet is unplugged"
    echo "  • Zero resource usage when tablet is not connected"
    echo ""
    echo "To test: Plug in your tablet and check status with:"
    echo "  systemctl status sketchatone"
}

# Configure always-on mode
setup_always_on() {
    print_info "Configuring always-on mode..."
    echo ""
    
    # Remove USB trigger rules (keep permission rules)
    if [ -f "$UDEV_RULES_FILE" ]; then
        # Generate permission-only rules
        local device_ids
        device_ids="$(get_device_ids "$DEVICES_DIR")" || return $?
        local rules=""
        rules+="# Sketchatone udev rules - HID permissions only\n"
        rules+="\n"
        
        while IFS=: read -r vendor product name; do
            if [ -n "$vendor" ]; then
                rules+="# $name\n"
                rules+="SUBSYSTEM==\"hidraw\", ATTRS{idVendor}==\"$vendor\", ATTRS{idProduct}==\"$product\", MODE=\"0666\"\n"
            fi
        done <<< "$device_ids"
        
        echo -e "$rules" > "$UDEV_RULES_FILE"
        reload_udev
    fi
    
    # Enable and start service
    systemctl enable sketchatone
    systemctl start sketchatone
    
    echo ""
    print_success "Always-on mode configured!"
    echo ""
    echo "  • Sketchatone will start automatically on system boot"
    echo "  • Service is now running"
    echo ""
    echo "Check status with:"
    echo "  systemctl status sketchatone"
}

# Configure manual mode
setup_manual() {
    print_info "Configuring manual mode..."
    echo ""
    
    # Stop and disable service
    if systemctl is-active --quiet sketchatone 2>/dev/null; then
        systemctl stop sketchatone
    fi
    if systemctl is-enabled --quiet sketchatone 2>/dev/null; then
        systemctl disable sketchatone
    fi
    
    # Keep permission rules but remove trigger rules
    if [ -f "$UDEV_RULES_FILE" ]; then
        local device_ids
        device_ids="$(get_device_ids "$DEVICES_DIR")" || return $?
        local rules=""
        rules+="# Sketchatone udev rules - HID permissions only\n"
        rules+="\n"
        
        while IFS=: read -r vendor product name; do
            if [ -n "$vendor" ]; then
                rules+="# $name\n"
                rules+="SUBSYSTEM==\"hidraw\", ATTRS{idVendor}==\"$vendor\", ATTRS{idProduct}==\"$product\", MODE=\"0666\"\n"
            fi
        done <<< "$device_ids"
        
        echo -e "$rules" > "$UDEV_RULES_FILE"
        reload_udev
    fi
    
    echo ""
    print_success "Manual mode configured!"
    echo ""
    echo "  • Sketchatone will NOT start automatically"
    echo "  • Run manually with: sketchatone"
    echo "  • Or start service with: sudo systemctl start sketchatone"
}

# Show current status
show_status() {
    echo ""
    echo "=========================================="
    echo "Sketchatone Configuration Status"
    echo "=========================================="
    echo ""

    # Check installation
    if [ -d "$INSTALL_DIR" ]; then
        print_success "Installation: Found at $INSTALL_DIR"
    else
        print_error "Installation: NOT FOUND"
        return
    fi

    # Check install mode (ALSA vs Zynthian)
    if [ -f "$INSTALL_DIR/.install-mode" ]; then
        local install_mode=$(cat "$INSTALL_DIR/.install-mode")
        if [ "$install_mode" = "zynthian" ]; then
            print_success "Install mode: Zynthian (JACK)"
        else
            print_success "Install mode: Standard Pi (ALSA)"
        fi
    else
        print_warning "Install mode: Unknown (legacy install?)"
    fi

    # Check config
    if [ -f "$CONFIG_DIR/config.json" ]; then
        print_success "Config: $CONFIG_DIR/config.json"
    else
        print_warning "Config: Not found (using defaults)"
    fi

    # Check device configs
    local device_ids
    device_ids="$(get_device_ids "$DEVICES_DIR")" || return $?
    local device_count=0
    while IFS=: read -r vendor product name; do
        [ -n "$vendor" ] && device_count=$((device_count + 1))
    done <<< "$device_ids"

    if [ $device_count -gt 0 ]; then
        print_success "Device configs: $device_count found"
    else
        print_warning "Device configs: None found"
    fi

    # Check service status
    echo ""
    if [ -f "$UI_AUTOSTART_MARKER" ]; then
        print_info "UI autostart: Enabled for $(cat "$UI_AUTOSTART_MARKER") (requires always-on)"
    fi
    if systemctl is-enabled --quiet sketchatone 2>/dev/null; then
        print_info "Service: Enabled (starts on boot)"
    else
        print_info "Service: Disabled (manual start)"
    fi

    if systemctl is-active --quiet sketchatone 2>/dev/null; then
        print_success "Service: Running"
    else
        print_info "Service: Stopped"
    fi

    # Check udev rules
    echo ""
    if [ -f "$UDEV_RULES_FILE" ]; then
        if grep -q "SYSTEMD_WANTS" "$UDEV_RULES_FILE" 2>/dev/null; then
            print_success "Mode: USB-triggered (starts when tablet plugged in)"
        else
            print_info "Mode: Permission rules only"
        fi
    else
        print_info "Mode: No udev rules configured"
    fi

    echo ""
}

# Main
case "${1:-}" in
    --mode)
        check_root
        check_installed
        case "${2:-}" in
            usb-trigger)
                check_ui_autostart_mode usb-trigger
                setup_usb_trigger
                ;;
            always-on)
                setup_always_on
                ;;
            manual)
                check_ui_autostart_mode manual
                setup_manual
                ;;
            *)
                print_error "Invalid mode: ${2:-<empty>}"
                echo "Valid modes: usb-trigger, always-on, manual"
                exit 1
                ;;
        esac
        ;;
    --list-devices)
        check_installed
        list_devices
        ;;
    --status)
        check_installed
        show_status
        ;;
    --help|-h|"")
        show_usage
        ;;
    *)
        print_error "Unknown option: $1"
        show_usage
        exit 1
        ;;
esac
