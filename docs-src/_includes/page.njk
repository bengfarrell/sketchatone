{% include "header.njk" %}
<div class="reference-shell section-wrap">
  <aside class="reference-sidebar">
    <details class="reference-menu" open>
      <summary>Browse the reference</summary>
      {% include "side-nav.njk" %}
    </details>
  </aside>
  <main id="main-content" class="reference-main">
      <p class="eyebrow">Sketchatone / Reference</p>
      <p class="reference-description">{{ description }}</p>
      <div class="prose">{{ content | safe }}</div>
  </main>
</div>
<script>
  document.querySelector('.reference-menu').open = window.matchMedia('(min-width: 741px)').matches;
</script>
{% include "footer.njk" %}
